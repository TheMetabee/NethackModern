ifeq "$(HAVE_SNDLIB)" "1"
# note:	one possible value for $(SNDLIBSRC) is 'macsound.m' which is written
#	in Objective-C; this relies on $(CC) recognizing the filename suffix
#	and knowing how to handle that; clang on MacOS does, both when
#	masquerading as gcc and when invoked as itself
ifdef SNDLIBSRC
$(TARGETPFX)$(filter-out $(MASOUNDOBJ),$(SNDLIBOBJ)): $(SNDLIBSRC) $(HACK_H)
	$(CC) $(CFLAGS) -c -o $@ $(SNDLIBSRC)
endif  # SNDLIBSRC

ifdef WANT_MINIAUDIO
$(TARGETPFX)masound.o: ../sound/miniaudio/masound.c \
		../sound/miniaudio/nhminiaudio.h $(HACK_H)
	$(CC) $(CFLAGS) -c -o $@ ../sound/miniaudio/masound.c
# third-party miniaudio: built with its own defaults, no warnings
$(TARGETPFX)nhminiaudio.o: ../sound/miniaudio/nhminiaudio.c \
		../sound/miniaudio/nhminiaudio.h ../sound/miniaudio/miniaudio.h
	$(CC) $(CFLAGS) -w -c -o $@ ../sound/miniaudio/nhminiaudio.c
endif  # WANT_MINIAUDIO

ifeq "$(NEEDS_WAV)" "1"

$(WAVDIR)/%.wav: ../util/uudecode $(WAVDIR)/%.uu
	$^
	mv $(notdir $@) $@

../util/uudecode: ../sys/share/uudecode.c
	( cd ../util ; $(MAKE) uudecode )

endif  # NEEDS_WAV
endif  # HAVE_SNDLIB

# end of multisnd-post
#==============================================================================

